# Single Node process, one deployment database, logical group/brand/store ledgers.
TYHR_DATA_MODE=postgres
DATABASE_URL=postgresql://USERNAME:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
PORT=8787
HOST=127.0.0.1
NODE_ENV=production

# PostgreSQL sensitive originals and integration credentials use 32-byte
# base64 keys. Generate locally, store outside Git, and retain with backups.
# The data key falls back to the integration key if not set separately.
# TYHR_INTEGRATION_VAULT_KEY=YOUR_LOCALLY_GENERATED_32_BYTE_BASE64_KEY
# TYHR_DATA_VAULT_KEY=YOUR_SEPARATE_32_BYTE_BASE64_KEY
# Enable approved salary-parameter sandbox and its in-process worker:
# TYHR_PAYROLL_SCRIPT_SANDBOX=quickjs-wasm-v1

# Broker is an alternative to DATABASE_URL, using the documented application
# contract; these are placeholders, not Qwen/DingTalk vendor API addresses.
# TYHR_DATA_MODE=broker
# TYHR_BROKER_CAPABILITIES_URL=https://YOUR_BROKER/capabilities
# TYHR_BROKER_QUERY_URL=https://YOUR_BROKER/query
# TYHR_BROKER_COMMAND_URL=https://YOUR_BROKER/command
# TYHR_BROKER_TOKEN=SET_A_SERVER_ONLY_SECRET
# TYHR_BROKER_TIMEOUT_MS=10000

# Local demo initialization only, never implicit at startup:
# TYHR_RUNTIME_DIR=/absolute/private/runtime
# TYHR_ADMIN_PASSWORD=SET_LOCALLY
# TYHR_OPERATOR_INITIAL_PASSWORD=SET_LOCALLY_FOR_EXPLICIT_DEMO_FACTORY
# TYHR_DEMO_PASSWORD=SET_LOCALLY

# Exact public application origins approved for enterprise platform login.
# Empty disables public SSO entrypoints. Do not use wildcard origins.
# TYHR_SSO_ALLOWED_ORIGINS=https://hr.YOUR_DOMAIN

# Explicit public origins allowed in workflow notification rules. Empty blocks
# rule configuration and delivery; request Host is never used as a fallback.
# TYHR_NOTIFICATION_ALLOWED_ORIGINS=https://hr.YOUR_DOMAIN
# Full demo factory only: choose an explicit origin also present above.
# TYHR_NOTIFICATION_DEMO_ORIGIN=https://hr.YOUR_DOMAIN

# Explicitly opt in after configuring and reviewing the e-signing provider.
# Default 0 keeps all real e-sign network jobs queued and sends no invitation.
TYHR_ESIGN_ALLOW_LIVE=0
