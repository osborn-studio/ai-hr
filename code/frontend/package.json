{
  "name": "ty-hr-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "node --test test/contracts.test.mjs test/platform-model.test.mjs test/private-commands.test.mjs test/rostering-model.test.mjs test/payroll-model.test.mjs test/performance-model.test.mjs test/performance-journal.test.mjs test/private-recovery.test.mjs",
    "test:ui": "node test/ui-smoke.mjs",
    "check": "node --test test/contracts.test.mjs && vite build",
    "test:platform-ui": "node test/platform-ui.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "playwright": "1.62.1"
  }
}
